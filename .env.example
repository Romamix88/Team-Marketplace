# === Wildberries API (отдельный токен на каждого агента) ===
# Создайте токены в ЛК WB: Настройки → Доступ к API
# Каждому токену назначьте только нужные разделы

# Логист: Статистика + Marketplace (склады, поставки)
WB_TOKEN_LOGISTICS=your_wb_token_logistics

# Контент-менеджер: Контент + Аналитика
WB_TOKEN_CONTENT=your_wb_token_content

# Маркетолог: Продвижение + Аналитика
WB_TOKEN_MARKETING=your_wb_token_marketing

# Аналитик: Статистика + Аналитика + Цены и скидки
WB_TOKEN_ANALYST=your_wb_token_analyst

# Бухгалтер: Финансы + Статистика
WB_TOKEN_ACCOUNTANT=your_wb_token_accountant

# Руководитель: все разделы (полный доступ)
WB_TOKEN_MANAGER=your_wb_token_manager

# === RouterAI (OpenAI-compatible) ===
ROUTERAI_API_KEY=your_routerai_key
ROUTERAI_BASE_URL=https://api.routerai.ru/v1

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === MCP ===
MCP_WB_URL=http://mcp-wb:8001

# === Dashboard ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# === Logging ===
LOG_LEVEL=INFO
